{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Auth": {
    "Cookie": {
      "Name": "mtca.auth",
      "RefreshName": "mtca.rt",
      "CsrfName": "mtca.csrf",
      "Secure": true,
      "SameSite": "Lax",
      "HttpOnly": true
    }
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Key": "",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowCredentials": true,
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
