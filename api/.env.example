# =================================================================
# MTCA API — prod/staging env catalog (docker-compose)
# Copy to `.env` and fill real values before `docker compose up`.
# ASP.NET Core does NOT auto-read this file; docker-compose reads it
# and injects each key as env var into the api container.
# Nested config keys use `__` instead of `:` (Microsoft convention).
# =================================================================

# ----- Runtime -----
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# ----- JWT -----
Jwt__Issuer=https://api.mtca.io
Jwt__Audience=mtca-web
Jwt__Key=__REPLACE_WITH_RANDOM_64_CHARS__
Jwt__AccessTokenMinutes=120
Jwt__RefreshTokenDays=30

# ----- Cookie auth (swap Domain when migrating) -----
Auth__Cookie__Name=mtca.auth
Auth__Cookie__Domain=.mtca.io
Auth__Cookie__SameSite=Lax
Auth__Cookie__Secure=true
Auth__Cookie__HttpOnly=true

# ----- CORS (array — add more indexes as needed) -----
Cors__AllowCredentials=true
Cors__AllowedOrigins__0=https://web.mtca.io

# ----- Public URL (for email links, redirects) -----
PublicUrl__Web=https://web.mtca.io
PublicUrl__Api=https://api.mtca.io

# ----- Data layer -----
ConnectionStrings__Default=Server=sqlserver,1433;Database=MTCA;User Id=sa;Password=__SA_PASSWORD__;TrustServerCertificate=true;MultipleActiveResultSets=true
Redis__Connection=redis:6379

# =================================================================
# The following keys will be wired in subsequent setup steps when
# CAS side-car / SMTP services are added.
# Left commented to document the full catalog from tech_stack §10.2.
# =================================================================

# ----- CAS side-car -----
# CasService__BaseUrl=http://cas:8000
# CasService__TimeoutSeconds=10
# CasService__SharedSecret=__SHARED_WITH_CAS__

# ----- SMTP -----
# Smtp__Host=smtp.example.com
# Smtp__Port=587
# Smtp__User=noreply@mtca.io
# Smtp__Password=__SMTP_PASSWORD__
# Smtp__FromAddress=noreply@mtca.io
# Smtp__FromName=MTCA
