@{
    ViewData["Title"] = "Giao đề thi";
    ViewBag.HideHeader = true;
    ViewBag.HideSidebar = true;
    ViewBag.IsFullWidth = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Exam/assign_exam.css">
}

<main class="page-shell py-4">
        <div class="container-fluid px-3 px-md-4">
            <section class="page-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
                <div>
                    <h1 class="page-title">Giao đề thi</h1>
                    <p class="page-subtitle">Thiết lập cấu hình bài tập, đề thi và gán cho sinh viên một cách chuyên nghiệp.</p>
                </div>
                <div class="page-actions">
                    <button class="btn btn-outline-secondary" type="button" id="closeConfigTop">Hủy bỏ</button>
                    <button class="btn btn-primary px-4" type="button" id="saveConfigTop">Lưu cấu hình</button>
                </div>
            </section>

            <section class="stepper mb-4" id="stepper">
                <div class="step active" data-step="1">
                    <div class="step-icon">1</div>
                    <div class="step-label">Thông tin chung</div>
                </div>
                <div class="step-line"></div>
                <div class="step" data-step="2">
                    <div class="step-icon">2</div>
                    <div class="step-label">Nội dung đề thi</div>
                </div>
                <div class="step-line"></div>
                <div class="step" data-step="3">
                    <div class="step-icon">3</div>
                    <div class="step-label">Cấu hình & Quy tắc</div>
                </div>
            </section>

            <div id="step1Content" class="step-content">
                <section class="panel-card mb-4">
                    <h2 class="section-title mb-4">Thông tin cơ bản</h2>
                    <div class="row g-2">
                        <div class="col-12 col-md-8">
                            <label class="form-label">Tiêu đề đề thi *</label>
                            <input class="form-control" id="examTitleInput" value="" placeholder="Ví dụ: Kiểm tra giữa kỳ 1">
                            <div class="invalid-feedback">Vui lòng nhập tiêu đề đề thi.</div>
                        </div>
                    </div>

                    <hr class="section-divider">

                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">Mô tả</label>
                            <textarea class="form-control" id="examDescriptionInput" rows="3" placeholder="Nhập mô tả hoặc quy định thi..."></textarea>
                        </div>
                    </div>
                    <div id="preSelectedClassInfo" class="mt-4">
                        <h2 class="section-title mb-3">Giao đề cho lớp học</h2>
                        <div class="summary-card py-3 px-3 bg-light border-0 rounded shadow-sm">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 50px; height: 50px; font-size: 1.25rem;">
                                    L
                                </div>
                                <div>
                                    <h3 class="h5 mb-1" id="displayClassName">Đang tải...</h3>
                                    <script>
                                        (function() {
                                            const name = sessionStorage.getItem('currentClassName');
                                            const el = document.getElementById('displayClassName');
                                            if (name && el) el.textContent = 'Lớp: ' + name;
                                        })();
                                    </script>
                                    <p class="form-note mb-0 text-muted">Môn học: <strong id="displaySubjectCode">@(ViewBag.SubjectCode ?? "-")</strong></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button class="btn btn-primary px-5 py-3" type="button" id="btnNext1">Tiếp theo: Chọn nội dung ➔</button>
                    </div>
                </section>
            </div>

            <div id="step2Content" class="step-content d-none">
                <section class="panel-card mb-4 shadow-lg">
                    <h2 class="section-title mb-4">Kiểu tạo đề *</h2>
                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <div class="d-flex flex-column flex-md-row gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="examGenerationMode" id="examGenerationBlueprint" checked>
                                    <label class="form-check-label" for="examGenerationBlueprint">Tạo theo ma trận đề</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="examGenerationMode" id="examGenerationManual">
                                    <label class="form-check-label" for="examGenerationManual">Chọn câu hỏi thủ công</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="blueprintModeSection">
                        <h2 class="section-title">Chọn ma trận đề *</h2>
                        <div class="row g-3" id="blueprintSelectionSection">
                            <div class="col-12 col-xl-5">
                                <div class="soft-card h-100" id="blueprintTableContainer">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        <h3 class="section-title mb-0">Danh sách ma trận đề</h3>
                                        <span class="form-note" id="selectedBlueprintName">Đang chọn: -</span>
                                    </div>

                                    <div class="row g-2 mb-2">
                                        <div class="col-12">
                                            <input class="form-control" id="blueprintSearchInput" placeholder="Tìm theo tên ma trận đề (ví dụ: pt1)">
                                        </div>
                                    </div>

                                    <div class="border rounded bg-white overflow-auto" style="max-height: 320px;">
                                        <table class="table table-soft table-sm align-middle mb-0" id="blueprintListTable">
                                            <thead>
                                                <tr>
                                                    <th style="width: 56px;">Chọn</th>
                                                    <th>Tên ma trận đề</th>
                                                    <th>Môn học</th>
                                                    <th>Ngày cập nhật</th>
                                                </tr>
                                            </thead>
                                            <tbody id="blueprintTableBody"></tbody>
                                        </table>
                                        <template id="blueprintRowTemplate">
                                            <tr class="interactive-row">
                                                <td><input class="form-check-input blueprint-item" type="radio" name="selectedBlueprint"></td>
                                                <td data-field-name></td>
                                                <td data-field-subject></td>
                                                <td data-field-updated></td>
                                            </tr>
                                        </template>
                                        <template id="blueprintStatusTemplate">
                                            <tr><td colspan="4" class="text-center" data-message></td></tr>
                                        </template>
                                    </div>
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-2">
                                        <p class="form-note mb-0" id="blueprintFilterSummary">Đang tải danh sách ma trận đề...</p>
                                        <nav aria-label="Phân trang ma trận đề" class="mt-2">
                                            <ul class="pagination pagination-sm mb-0">
                                                <li class="page-item"><button class="page-link" type="button" id="blueprintPaginationPrev">Trước</button></li>
                                                <li class="page-item"><button class="page-link" type="button" id="blueprintPaginationNext">Sau</button></li>
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-xl-7">
                                <div class="soft-card h-100">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        <h3 class="section-title mb-0">Chi tiết ma trận đề</h3>
                                        <span class="tag-pill tag-neutral" id="blueprintInfoSubject">-</span>
                                    </div>
                                    <div id="blueprintMatrixContainer">
                                        <div class="row g-2 mb-2">
                                            <div class="col-12">
                                                <div class="summary-card py-2">
                                                    <p class="summary-label mb-1">Số câu hỏi của mã đề</p>
                                                    <p class="mb-0 fw-semibold" id="blueprintInfoQuestionCount">0 câu</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="table-responsive border rounded bg-white">
                                            <table class="table table-soft table-sm align-middle mb-0" id="blueprintMatrixTable">
                                                <thead>
                                                    <tr>
                                                        <th>Chương</th>
                                                        <th>Mức độ</th>
                                                        <th>Số câu</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="blueprintMatrixBody"></tbody>
                                            </table>
                                        </div>
                                        <template id="matrixStatusTemplate">
                                            <tr><td colspan="3" class="text-center" data-message></td></tr>
                                        </template>
                                        <template id="blueprintMatrixRowTemplate">
                                            <tr>
                                                <td data-field-chapter></td>
                                                <td data-field-difficulty></td>
                                                <td data-field-questions></td>
                                            </tr>
                                        </template>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="invalid-feedback" id="blueprintErrorFeedback">Vui lòng chọn một ma trận đề.</div>

                        <!-- ★ MỚI: Chọn nguồn câu hỏi (hiện ra sau khi chọn ma trận) -->
                        <div id="blueprintBankSelectionSection" class="mt-4" style="display: none;">
                            <h2 class="section-title">Chọn nguồn câu hỏi *</h2>
                            <p class="form-note mb-3">Chọn các ngân hàng câu hỏi sẽ được dùng để sinh đề. Mặc định: tất cả ngân hàng của bạn cho môn này + kho chung.</p>
                            <div class="row g-3">
                                <div class="col-12 col-xl-7">
                                    <div class="soft-card h-100 p-0 border">
                                        <div class="table-responsive bg-white rounded" style="max-height: 250px;">
                                            <table class="table table-soft table-sm align-middle mb-0" id="blueprintBankTable">
                                                <thead class="position-sticky top-0 bg-white shadow-sm z-1">
                                                    <tr>
                                                        <th style="width: 40px;" class="text-center">
                                                            <input class="form-check-input" type="checkbox" id="blueprintBankSelectAll" checked>
                                                        </th>
                                                        <th>Tên ngân hàng</th>
                                                        <th>Loại</th>
                                                        <th class="text-end">Khả dụng</th>
                                                        <th class="text-end">Dự kiến</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="blueprintBankTableBody">
                                                    <tr><td colspan="5" class="text-center text-muted py-3">Đang tải...</td></tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-xl-5">
                                    <div class="soft-card h-100 d-flex flex-column">
                                        <div class="row g-2 mb-2 flex-grow-1">
                                            <div class="col-6">
                                                <div class="summary-card py-2 px-3 h-100">
                                                    <p class="summary-label mb-1">Khả dụng</p>
                                                    <p class="mb-0 fw-bold text-primary fs-5" id="poolTotalAvailable">0</p>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="summary-card py-2 px-3 h-100">
                                                    <p class="summary-label mb-1">Yêu cầu</p>
                                                    <p class="mb-0 fw-bold fs-5" id="poolTotalRequired">0</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="poolValidationStatus" class="p-2 rounded border bg-light mt-auto">
                                            <div class="d-flex align-items-center gap-2 text-muted">
                                                <div class="spinner-border spinner-border-sm" role="status"></div>
                                                <span class="fw-medium small">Đang tính toán...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="manualModeSection" class="d-none">
                        <h2 class="section-title mb-3">Thêm câu hỏi thủ công *</h2>
                        <div class="row g-3" id="manualQuestionContainer">
                            <!-- Cột trái: Filter sidebar -->
                            <div class="col-12 col-lg-3">
                                <div class="soft-card position-sticky top-0" style="max-height: calc(100vh - 100px); overflow-y: auto;">
                                    <h6 class="fw-bold mb-3 border-bottom pb-2">Lọc theo ngân hàng</h6>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="manualBankSelectAll" checked>
                                        <label class="form-check-label fw-medium" for="manualBankSelectAll">Tất cả ngân hàng dùng được</label>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <div class="text-muted small fw-bold mb-2">CỦA TÔI (PERSONAL)</div>
                                        <div id="manualPersonalBanks" class="d-flex flex-column gap-1">
                                            <span class="small text-muted">Đang tải...</span>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <div class="text-muted small fw-bold mb-2">KHO CHUNG</div>
                                        <div id="manualSharedBanks" class="d-flex flex-column gap-1">
                                            <span class="small text-muted">Đang tải...</span>
                                        </div>
                                    </div>

                                    <h6 class="fw-bold mt-4 mb-3 border-bottom pb-2">Lọc theo thuộc tính</h6>
                                    <div class="mb-2">
                                        <label class="form-label small mb-1">Chương</label>
                                        <select class="form-select form-select-sm" id="manualQuestionChapterFilter">
                                            <option value="">Tất cả chương</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small mb-1">Mức độ</label>
                                        <select class="form-select form-select-sm" id="manualQuestionLevelFilter">
                                            <option value="">Tất cả</option>
                                            <option value="1">Nhận biết</option>
                                            <option value="2">Thông hiểu</option>
                                            <option value="3">Vận dụng</option>
                                            <option value="4">Vận dụng cao</option>
                                        </select>
                                    </div>
                                    
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-primary flex-grow-1" type="button" id="manualBtnApplyFilter">Áp dụng</button>
                                        <button class="btn btn-sm btn-outline-secondary" type="button" id="manualBtnClearFilter">Xóa lọc</button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Cột phải: Table picker -->
                            <div class="col-12 col-lg-9 d-flex flex-column">
                                <div class="soft-card flex-grow-1 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        <div>
                                            <span class="form-note mb-0">Hiển thị <strong id="manualFilterCount">0</strong> / <strong id="manualTotalCount">0</strong> câu sau khi lọc</span>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary" type="button" id="manualQuestionClearButton">Bỏ chọn tất cả</button>
                                    </div>
                                    <div class="table-responsive border rounded bg-white flex-grow-1" style="min-height: 400px; max-height: 500px; overflow-y: auto;">
                                        <table class="table table-soft table-sm align-middle mb-0" id="manualQuestionTable">
                                            <thead class="position-sticky top-0 bg-white shadow-sm z-1">
                                                <tr>
                                                    <th style="width: 40px;" class="text-center">Chọn</th>
                                                    <th style="width: 60px;">#</th>
                                                    <th>Nội dung</th>
                                                    <th style="width: 130px;">Bank nguồn</th>
                                                    <th style="width: 100px;">Chương</th>
                                                    <th style="width: 80px;">Mức</th>
                                                    <th style="width: 60px;" class="text-center">Xem</th>
                                                </tr>
                                            </thead>
                                            <tbody id="manualQuestionTableBody"></tbody>
                                        </table>
                                        <template id="manualQuestionRowTemplate">
                                            <tr>
                                                <td class="text-center"><input class="form-check-input manual-item" type="checkbox"></td>
                                                <td data-field-id class="text-muted small"></td>
                                                <td>
                                                    <div class="text-truncate" style="max-width: 250px;" data-field-content></div>
                                                </td>
                                                <td data-field-bank></td>
                                                <td data-field-chapter class="small"></td>
                                                <td data-field-level class="small"></td>
                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-link p-0 text-decoration-none" data-action-view>
                                                        <i class="bi bi-info-circle"></i> Xem
                                                    </button>
                                                </td>
                                            </tr>
                                        </template>
                                        <template id="manualQuestionStatusTemplate">
                                            <tr><td colspan="7" class="text-center py-4" data-message></td></tr>
                                        </template>
                                    </div>
                                    <div class="d-flex flex-column flex-md-row justify-content-center align-items-md-center gap-2 mt-3">
                                        <nav aria-label="Phân trang câu hỏi">
                                            <ul class="pagination pagination-sm mb-0">
                                                <li class="page-item"><button class="page-link" type="button" id="manualQuestionPaginationPrev">Trước</button></li>
                                                <li class="page-item"><button class="page-link" type="button" id="manualQuestionPaginationNext">Sau</button></li>
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                                
                                <!-- Bottom sticky bar -->
                                <div class="p-3 mt-3 bg-white border rounded shadow-sm position-sticky bottom-0 z-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fs-6">Đã chọn <strong id="manualSelectedCount" class="text-warning fs-5">0</strong> / <strong id="manualRequiredCount" class="fs-5">0</strong> câu</span>
                                        <div id="manualSelectionWarning" class="small text-danger d-none mt-1">Cần chọn đủ số câu hỏi để tiếp tục.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="invalid-feedback" id="manualErrorFeedback">Vui lòng chọn đủ câu hỏi thủ công.</div>
                    </div>

                    <div class="d-flex justify-content-between mt-5 pt-3 border-top">
                        <button class="btn btn-outline-secondary px-4" type="button" id="btnBack2">← Quay lại</button>
                        <button class="btn btn-primary px-5" type="button" id="btnNext2">Tiếp theo: Cấu hình ➔</button>
                    </div>
                </section>
            </div>

            <div id="step3Content" class="step-content d-none">
                <section class="panel-card mb-4 shadow-lg border-0">
                    <h2 class="section-title mb-4">Lịch thi & Thời gian *</h2>
                    <div class="row g-2">
                        <div class="col-12 col-md-3">
                            <label class="form-label">Thời điểm học sinh thấy đề *</label>
                            <input class="form-control" id="examVisibleFromInput" type="datetime-local">
                            <div class="invalid-feedback">Vui lòng chọn thời điểm hiển thị.</div>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Thời điểm mở *</label>
                            <input class="form-control" id="examOpenAtInput" type="datetime-local">
                            <div class="invalid-feedback">Vui lòng chọn thời điểm mở.</div>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Thời điểm đóng *</label>
                            <input class="form-control" id="examCloseAtInput" type="datetime-local">
                            <div class="invalid-feedback">Vui lòng chọn thời điểm đóng.</div>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Thời lượng (phút) *</label>
                            <input class="form-control" id="examDurationInput" type="number" value="40">
                            <div class="invalid-feedback">Vui lòng nhập thời lượng.</div>
                        </div>
                    </div>

                    <hr class="section-divider">

                    <h2 class="section-title">Cấu hình làm bài</h2>
                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label">Số lần làm *</label>
                            <input type="number" class="form-control" id="examMaxAttemptsInput" value="1">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Số mã đề *</label>
                            <input type="number" class="form-control" id="examPaperCountInput" value="1" min="1" max="50">
                        </div>
                    </div>

                    <div class="rules-compact-header d-flex align-items-center justify-content-between mb-3">
                        <h2 class="section-title mb-0">Quy tắc thi</h2>
                        <div class="form-check form-switch ms-3">
                            <input class="form-check-input" type="checkbox" id="rule1" checked>
                            <label class="form-check-label" for="rule1">Trộn câu hỏi</label>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="rule-card p-3 rounded-3 border h-100">
                                <h6 class="rule-card-title fw-semibold mb-1">Hiển thị điểm số</h6>
                                <p class="text-muted small mb-2">SV có xem được điểm không?</p>
                                <div class="d-flex flex-column gap-1">
                                    <div class="form-check form-check-sm">
                                        <input class="form-check-input" type="radio" name="showScore" id="scoreDisplayNone" value="0" checked>
                                        <label class="form-check-label small" for="scoreDisplayNone">Không hiển thị</label>
                                    </div>
                                    <div class="form-check form-check-sm">
                                        <input class="form-check-input" type="radio" name="showScore" id="scoreDisplayImmediate" value="1">
                                        <label class="form-check-label small" for="scoreDisplayImmediate">Ngay khi nộp bài</label>
                                    </div>
                                    <div class="form-check form-check-sm">
                                        <input class="form-check-input" type="radio" name="showScore" id="scoreDisplayAfterExam" value="2">
                                        <label class="form-check-label small" for="scoreDisplayAfterExam">Khi kết thúc kỳ thi</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="rule-card p-3 rounded-3 border h-100">
                                <h6 class="rule-card-title fw-semibold mb-1">Xem lại bài làm</h6>
                                <p class="text-muted small mb-2">SV có xem lại đáp án không?</p>
                                <div class="d-flex flex-column gap-1">
                                    <div class="form-check form-check-sm">
                                        <input class="form-check-input" type="radio" name="showAnswer" id="answerDisplayNone" value="0" checked>
                                        <label class="form-check-label small" for="answerDisplayNone">Không cho xem</label>
                                    </div>
                                    <div class="form-check form-check-sm">
                                        <input class="form-check-input" type="radio" name="showAnswer" id="answerDisplayStudentOnly" value="1">
                                        <label class="form-check-label small" for="answerDisplayStudentOnly">Chỉ bài làm của SV</label>
                                    </div>
                                    <div class="form-check form-check-sm">
                                        <input class="form-check-input" type="radio" name="showAnswer" id="answerDisplayWithCorrect" value="2">
                                        <label class="form-check-label small" for="answerDisplayWithCorrect">Cả đáp án đúng</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="rule-card p-3 rounded-3 border h-100">
                                <h6 class="rule-card-title fw-semibold mb-1">Thời điểm áp dụng</h6>
                                <p class="text-muted small mb-2">Khi nào SV được xem?</p>
                                <div class="d-flex flex-column gap-1">
                                    <div class="form-check form-check-sm">
                                        <input class="form-check-input" type="radio" name="answerTimingMode" id="answerTimingAfterSubmit" value="0" checked>
                                        <label class="form-check-label small" for="answerTimingAfterSubmit">Sau khi nộp bài</label>
                                    </div>
                                    <div class="form-check form-check-sm">
                                        <input class="form-check-input" type="radio" name="answerTimingMode" id="answerTimingAfterExam" value="1">
                                        <label class="form-check-label small" for="answerTimingAfterExam">Sau khi kết thúc thi</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-5 pt-3 border-top">
                        <button class="btn btn-outline-secondary px-4" type="button" id="btnBack3">← Quay lại bước 2</button>
                        <button class="btn btn-primary px-5 py-3" type="button" id="saveConfigBottom">Hoàn tất & Lưu cấu hình</button>
                    </div>
                </section>
            </div>
        </div>
    </main>

