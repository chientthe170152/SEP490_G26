@{
    ViewData["Title"] = "Làm bài thi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Exam/exam_taking.css" />
    <style>
        math-field::part(virtual-keyboard-toggle) {
            display: none;
        }

        math-field::part(menu-toggle) {
            display: none;
        }
    </style>
}

<main class="page-shell py-4" id="examWorkspace">
    <div class="container-fluid px-3 px-md-4">

        @* ── Header ── *@
        <section class="page-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h1 class="page-title">Kiểm tra</h1>
                <div class="badge bg-info mt-2" style="font-size: 1rem;">
                    <i class="bi bi-file-earmark-text"></i> Mã đề thi: <span id="examCodeSpan">---</span>
                </div>
            </div>
            <div class="soft-card">
                <div class="summary-label">Thời gian còn lại</div>
                <div class="countdown" id="countdownTimer">40:00</div>
            </div>
        </section>

        <div class="row g-3">
            @await Html.PartialAsync("_QuestionArea")

            @* ── Sidebar ── *@
            <div class="col-12 col-xl-4 exam-sidebar">
                <aside class="panel-card mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="panel-title mb-0">Điều hướng</h2>
                        <span class="progress-info small">
                            <i class="bi bi-check2-square text-success me-1"></i>
                            <strong id="answeredCount">0</strong> / <strong id="totalCount">0</strong> câu
                        </span>
                    </div>

                    <div class="question-nav mb-2" id="questionNav"></div>

                    <div class="nav-legend small text-muted mt-2 mb-3">
                        <span class="legend-item"><span class="legend-dot dot-current"></span>Đang xem</span>
                        <span class="legend-item"><span class="legend-dot dot-answered"></span>Đã làm</span>
                        <span class="legend-item"><span class="legend-dot dot-unanswered"></span>Chưa làm</span>
                        <span class="legend-item"><span class="legend-dot dot-error"></span>Lỗi</span>
                    </div>

                    <hr class="my-2">

                    <p class="small text-success mb-3 mb-0">
                        <i class="bi bi-cloud-check me-1"></i>Hệ thống sẽ tự động lưu bài
                    </p>

                    <button class="btn btn-danger w-100 mt-3" id="btnSubmitExam" onclick="confirmSubmit()">
                        <i class="bi bi-send-fill me-1"></i>Nộp bài
                    </button>
                </aside>

                @await Html.PartialAsync("_InputLimitContainer")
            </div>

        </div>
    </div>
</main>

@await Html.PartialAsync("_ExamTemplates")

@section Scripts {
    <script defer src="https://unpkg.com/mathlive"></script>
    <script src="~/js/exam_engine.js"></script>
    <script>
        var examEngine;
        var exam;

        // ── Timer variables ──
        var timerInterval = null;
        var remainingSeconds = 0;

        document.addEventListener('DOMContentLoaded', async () => {
            //Lấy giá trị examId
            const examId = new URLSearchParams(window.location.search).get('examId');

            //Kiểm tra tính hợp lệ
            if (!examId || isNaN(examId)) {
                showToast("Không tìm thấy mã bài thi hợp lệ trong URL.", "error");
                return;
            }

            apiClient.post(`/api/student/exams/${examId}/take`)
                .then((response) => {
                    exam = response;
                    
                    // Update exam code
                    const codeSpan = document.getElementById('examCodeSpan');
                    if (codeSpan && exam.code) {
                        codeSpan.textContent = exam.code;
                    }

                    examEngine = new ExamEngine({
                        data: exam,
                        studentAnswers: new Map((exam.savedAnswers || []).map(a => [String(a.questionAnswerId), a.response])),
                        onNavUpdated: function(qNum, questions, stdAnswers) {
                            const validation = examEngine.validateAllAnswers();
                            const invalidQNums = validation.invalidQNums || [];

                            document.querySelectorAll('#questionNav button').forEach((btn, idx) => {
                                const questionNum = idx + 1;
                                const question = questions[idx];
                                const hasAnswer = question && question.answers.some(a => stdAnswers.has(String(a.questionAnswerId)));

                                btn.classList.remove('btn-outline-primary', 'btn-primary', 'btn-danger', 'btn-success');

                                if (questionNum === qNum) {
                                    btn.classList.add('btn-primary');
                                } else if (invalidQNums.includes(questionNum)) {
                                    btn.classList.add('btn-danger');
                                    btn.title = "Có lỗi định dạng ở câu này";
                                } else if (hasAnswer) {
                                    btn.classList.add('btn-success');
                                    btn.removeAttribute('title');
                                } else {
                                    btn.classList.add('btn-outline-primary');
                                    btn.removeAttribute('title');
                                }
                            });
                            // Tự động lưu bài lưu nháp khi chuyển câu
                            if (typeof submitExam === 'function') {
                                submitExam(false);
                            }
                        },
                        onProgressUpdated: function(questions, stdAnswers) {
                            let answered = 0;
                            questions.forEach(q => {
                                if (q.answers.some(a => stdAnswers.has(String(a.questionAnswerId)))) answered++;
                            });
                            const countEl = document.getElementById('answeredCount');
                            if (countEl) countEl.textContent = answered;
                            const totalEl = document.getElementById('totalCount');
                            if (totalEl) totalEl.textContent = questions.length;
                        }
                    });
                    
                    examEngine.init();

                    // ── Khởi tạo bộ đếm thời gian ──
                    let createdAtStr = exam.createdAtUtc;
                    if (!createdAtStr.endsWith('Z') && !createdAtStr.includes('+')) {
                        createdAtStr += 'Z';
                    }
                    startCountdown(exam.duration, createdAtStr);
                })
                .catch((error) => {
                    showToast("Lỗi: " + error.message, "error");
                });
        });

        // ══════════════════════════════════════════
        // ── Bộ đếm thời gian nộp bài ──
        // ══════════════════════════════════════════

        function startCountdown(durationMinutes, createdAtUtcStr) {
            // Dừng timer cũ nếu có
            if (timerInterval) clearInterval(timerInterval);

            // Thời gian bắt đầu làm bài (UTC -> chuyển sang local timezone bằng Date object)
            let createdAt = new Date(createdAtUtcStr);
            let durationSeconds = durationMinutes * 60;

            let updateTime = () => {
                let now = new Date();
                let elapsedSeconds = Math.floor((now - createdAt) / 1000);
                remainingSeconds = durationSeconds - elapsedSeconds;

                if (remainingSeconds <= 0) {
                    remainingSeconds = 0;
                    clearInterval(timerInterval);
                    updateTimerDisplay();
                    // Hết giờ → tự động nộp bài
                    showToast("Đã hết thời gian làm bài! Hệ thống sẽ tự động nộp bài.", "warning", 5000);
                    submitExam(true);
                    return;
                }
                updateTimerDisplay();
            };

            // Chạy ngay lần đầu để set thời gian
            updateTime();

            // Lặp lại mỗi giây
            timerInterval = setInterval(updateTime, 1000);
        }

        /**
         * Cập nhật hiển thị bộ đếm trên giao diện.
         */
        function updateTimerDisplay() {
            const minutes = Math.floor(remainingSeconds / 60);
            const seconds = remainingSeconds % 60;
            const display = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

            const el = document.getElementById('countdownTimer');
            if (el) {
                el.textContent = display;

                // Đổi màu khi còn ít thời gian (≤ 5 phút)
                if (remainingSeconds <= 300) {
                    el.style.color = '#dc3545';
                } else {
                    el.style.color = '';
                }
            }
        }

        /**
         * Xác nhận trước khi nộp bài (cho nút Nộp bài).
         */
        function confirmSubmit() {
            showConfirm('Bạn có chắc chắn muốn nộp bài?', 'Xác nhận nộp bài', () => submitExam(true));
        }

        function submitExam(isFinal) {
            if (examEngine) {
                examEngine.saveCurrentAnswers();
            }

            if (isFinal) {
                if (timerInterval) clearInterval(timerInterval);
            }

            const examId = parseInt(new URLSearchParams(window.location.search).get('examId'));
            const studentAnswerDtos = examEngine ? examEngine.getStudentAnswerDtos() : [];

            // Tạo SubmitExamRequest
            const requestBody = {
                examId: examId,
                studentAnswers: studentAnswerDtos,
                submit: isFinal
            };

            console.log('submitExam request:', requestBody);
            console.log('submitExam JSON:', JSON.stringify(requestBody));

            // Disable nút nộp bài để tránh nhấn nhiều lần
            const btnSubmit = document.getElementById('btnSubmitExam');
            if (btnSubmit) btnSubmit.disabled = true;

            apiClient.post('/api/submission/submit', requestBody)
                .then((response) => {
                    console.log('submitExam response:', response);

                    if (isFinal) {
                        // Hiển thị thông báo nộp bài
                        const submittedAt = new Date(response.submittedAtUtc);
                        const formattedTime = submittedAt.toLocaleString('vi-VN', {
                            timeZone: 'Asia/Ho_Chi_Minh',
                            year: 'numeric', month: '2-digit', day: '2-digit',
                            hour: '2-digit', minute: '2-digit', second: '2-digit'
                        });

                        if (response.isLate) {
                            showToast(`Nộp bài trễ! Thời điểm ghi nhận: ${formattedTime}. Bài làm của bạn đã được nộp nhưng đã quá thời hạn.`, "warning", 8000);
                        } else {
                            showToast(`Nộp bài thành công! Thời điểm ghi nhận: ${formattedTime}`, "success", 5000);
                        }

                        // Chuyển hướng hoặc vô hiệu hóa giao diện sau khi nộp
                        document.getElementById('examWorkspace').style.pointerEvents = 'none';
                        document.getElementById('examWorkspace').style.opacity = '0.6';
                    } else {
                        // Cập nhật lựa chọn thành công (không cần thông báo)
                        if (btnSubmit) btnSubmit.disabled = false;
                    }
                })
                .catch((error) => {
                    console.error('submitExam error:', error);
                    showToast('Lỗi khi nộp bài: ' + error.message, 'error');
                    if (btnSubmit) btnSubmit.disabled = false;

                    // Nếu nộp bài cuối cùng thất bại, khởi động lại timer
                    if (isFinal && remainingSeconds > 0) {
                        startCountdown(remainingSeconds / 60);
                    }
                });
        }
    </script>
}