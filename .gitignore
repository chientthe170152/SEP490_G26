# =================================================
# MTCA monorepo — root .gitignore
# Per-subdir (api/, cas/, web/) has its own .gitignore for build artifacts.
# This file covers IDE, OS, and cross-cutting artifacts only.
# =================================================

# IDE / editor
.vs/
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Root-level env (should not exist — each service keeps its own .env)
.env

# Claude Code local settings
.claude/
.plan/
.agents/